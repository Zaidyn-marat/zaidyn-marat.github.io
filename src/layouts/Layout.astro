---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="nav-brand">
        <img src="/logo.svg" alt="Laboratory Logo" class="nav-logo" />
        <span>LABORATORY</span>
      </a>

      <div class="nav-right">
        <div class="nav-links">
          <a href="/" data-i18n="nav.home">Home</a>

          <div class="nav-dropdown">
            <a href="/research" class="dropdown-trigger" data-i18n="nav.research">Research ▾</a>
            <div class="dropdown-menu">
              <a href="/research" data-i18n="nav.directions">Research Directions</a>
              <a href="/publications" data-i18n="nav.publications">Publications</a>
            </div>
          </div>

          <div class="nav-dropdown">
            <span class="dropdown-trigger" data-i18n="nav.swhw">Software & Hardware ▾</span>
            <div class="dropdown-menu">
              <a href="/software" data-i18n="nav.software">Software & Code</a>
              <a href="/instrumentation" data-i18n="nav.hardware">Hardware & Facilities</a>
            </div>
          </div>

          <a href="/people" data-i18n="nav.people">People</a>
          <a href="/courses" data-i18n="nav.courses">Courses</a>
          <a href="/media" data-i18n="nav.media">Media</a>
        </div>

        <!-- 三语切换器 -->
        <div class="lang-switcher" role="group" aria-label="Language selector">
          <button type="button" data-lang="en" class="lang-btn active">EN</button>
          <span class="lang-sep">/</span>
          <button type="button" data-lang="kk" class="lang-btn">ҚАЗ</button>
          <span class="lang-sep">/</span>
          <button type="button" data-lang="ru" class="lang-btn">РУС</button>
        </div>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <script>
      import { translations } from '../i18n/translations';

      type Lang = keyof typeof translations;

      function applyLanguage(lang: Lang) {
        const dict = translations[lang] || translations.en;
        document.documentElement.lang = lang;
        localStorage.setItem('lab-lang', lang);

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n') as keyof typeof dict;
          if (key && dict[key]) {
            el.textContent = dict[key];
          }
        });

        document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach((btn) => {
          btn.classList.toggle('active', btn.dataset.lang === lang);
        });
      }

      const saved = (localStorage.getItem('lab-lang') as Lang) || 'en';
      applyLanguage(saved);

      document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetLang = btn.dataset.lang as Lang;
          if (targetLang) applyLanguage(targetLang);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  html, body {
    width: 100%;
    overflow-x: hidden;
    background-color: #ffffff;
    color: #1f2937;
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .navbar, .container {
    width: 100%;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    padding-top: 1.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #e5e7eb;
    position: relative;
    z-index: 50;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #111827;
    flex-shrink: 0;
  }

  .nav-logo {
    height: 32px;
    width: auto;
    display: block;
  }

  .nav-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.35rem;
  }

  .nav-links > a,
  .dropdown-trigger {
    color: #4b5563;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    padding: 0.4rem 0;
    display: inline-block;
    transition: color 0.2s;
  }

  .nav-links > a:hover,
  .nav-dropdown:hover .dropdown-trigger {
    color: #1d4ed8;
  }

  .nav-dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    padding: 0.4rem 0;
    z-index: 100;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    display: flex;
    flex-direction: column;
  }

  .dropdown-menu a {
    color: #374151;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.55rem 1rem;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }

  .dropdown-menu a:hover {
    background-color: #f3f4f6;
    color: #1d4ed8;
  }

  /* 语言切换按钮样式 */
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding-left: 1rem;
    border-left: 1px solid #e5e7eb;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.78rem;
  }

  .lang-btn {
    background: none;
    border: none;
    color: #9ca3af;
    font-family: inherit;
    font-size: inherit;
    font-weight: 600;
    cursor: pointer;
    padding: 0.15rem 0.25rem;
    transition: color 0.15s;
  }

  .lang-btn:hover {
    color: #111827;
  }

  .lang-btn.active {
    color: #111827;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }

  .lang-sep {
    color: #d1d5db;
  }

  .container {
    margin-top: 2.5rem;
    margin-bottom: 4rem;
    overflow-wrap: break-word;
  }

  h1, h2 {
    font-family: 'Source Serif 4', Georgia, serif;
    color: #111827;
    letter-spacing: -0.02em;
  }
</style>