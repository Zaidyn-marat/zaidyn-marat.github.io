---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="nav-brand">
        <img src="/logo.svg" alt="Laboratory Logo" class="nav-logo" />
        <span>LABORATORY</span>
      </a>

      <div class="nav-links">
        <a href="/">Home</a>

        <!-- Research 下拉菜单 -->
        <div class="nav-dropdown">
          <a href="/research" class="dropdown-trigger">Research ▾</a>
          <div class="dropdown-menu">
            <a href="/research">Research Directions</a>
            <a href="/publications">Publications</a>
          </div>
        </div>

        <!-- Software & Hardware 下拉菜单 -->
        <div class="nav-dropdown">
          <span class="dropdown-trigger">Software & Hardware ▾</span>
          <div class="dropdown-menu">
            <a href="/software">Software & Code</a>
            <a href="/instrumentation">Hardware & Facilities</a>
          </div>
        </div>

        <a href="/people">People</a>
        <a href="/courses">Courses</a>
        <a href="/media">Media</a>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    overflow-x: hidden;
    background-color: #ffffff;
    color: #1f2937;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.65;
  }

  .navbar, .container {
    width: 100%;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding-top: 1.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #e5e7eb;
    position: relative;
    z-index: 50;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #111827;
    flex-shrink: 0;
  }

  .nav-logo {
    height: 32px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links > a,
  .dropdown-trigger {
    color: #4b5563;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    padding: 0.4rem 0;
    display: inline-block;
    transition: color 0.2s;
  }

  .nav-links > a:hover,
  .nav-dropdown:hover .dropdown-trigger {
    color: #1d4ed8;
  }

  /* 下拉菜单容器 */
  .nav-dropdown {
    position: relative;
    display: inline-block;
  }

  /* 隐藏的下拉面板 */
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    padding: 0.4rem 0;
    z-index: 100;
  }

  /* 鼠标悬停时展开 */
  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    display: flex;
    flex-direction: column;
  }

  /* 下拉子项样式 */
  .dropdown-menu a {
    color: #374151;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.55rem 1rem;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }

  .dropdown-menu a:hover {
    background-color: #f3f4f6;
    color: #1d4ed8;
  }

  .container {
    margin-top: 2.5rem;
    margin-bottom: 4rem;
    overflow-wrap: break-word;
  }

  h1 {
    margin-bottom: 1.5rem;
    font-size: 2rem;
    color: #111827;
    letter-spacing: -0.02em;
  }

  h2 {
    color: #111827;
  }
</style>