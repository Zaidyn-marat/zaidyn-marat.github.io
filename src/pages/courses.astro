---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const courseList = await getCollection('courses');
---
<Layout title="Courses & Outreach | Laboratory">
  <h1 data-i18n="page.courses.univ">University Courses</h1>
  <div class="course-grid">
    {courseList.map(async (course) => {
      const { Content } = await render(course);
      return (
        <div class="course-card">
          <div class="course-meta">{course.data.code} • {course.data.semester}</div>
          <h2>{course.data.title}</h2>
          <div class="course-instructor">Instructor: {course.data.instructor}</div>
          <div class="course-desc"><Content /></div>
        </div>
      );
    })}
  </div>

  <section class="outreach-section">
    <h2 data-i18n="page.courses.outreach">Open STEM & Robotics Program (All Ages)</h2>
    <div class="chipbot-wrapper">
      <div class="chipbot-card">
        <div class="chipbot-header">
          <div>
            <h3>Chip&Bot — Центр Робототехники</h3>
            <span class="badge" data-i18n="chipbot.badge">Open to Students & Seniors • Zero Prerequisites</span>
          </div>
          <a href="https://www.instagram.com/chip_and_bot/" target="_blank" rel="noopener" class="ig-btn">
            @chip_and_bot ↗
          </a>
        </div>

        <p class="chipbot-bio" data-i18n="chipbot.bio">
          Hands-on robotics and embedded engineering workshops designed for everyone—from school and university students to lifelong learners and seniors. Learn to build working robots from scratch using Arduino, Raspberry Pi, and ESP32.
        </p>

        <div class="chipbot-details">
          <div data-i18n="chipbot.loc">Location: Almaty, KazNU, Al-Farabi 71/23</div>
          <div data-i18n="chipbot.curr">Curriculum: Electronics, Microcontrollers, Sensors & STEM Projects</div>
        </div>

        <div class="chipbot-actions">
          <a href="https://wa.me/77087461660" target="_blank" rel="noopener" class="wa-btn">
            WhatsApp: +7 708 746-16-60
          </a>
          <a href="https://www.instagram.com/chip_and_bot/" target="_blank" rel="noopener" class="outline-btn">
            View Instagram Feed
          </a>
        </div>
      </div>

      <div class="ig-embed-box">
        <iframe
          src="https://www.instagram.com/chip_and_bot/embed"
          width="100%"
          height="380"
          frameborder="0"
          scrolling="no"
          allowtransparency="true"
          title="Chip&Bot Instagram"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  .course-grid {
    display: grid;
    gap: 1.5rem;
  }

  .course-card {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-left: 4px solid #1d4ed8;
    border-radius: 6px;
    padding: 1.4rem;
  }

  .course-meta {
    color: #6b7280;
    font-size: 0.85rem;
    font-family: monospace;
  }

  .course-card h2 {
    font-size: 1.25rem;
    margin: 0.25rem 0;
  }

  .course-instructor {
    color: #4b5563;
    font-size: 0.9rem;
    margin-bottom: 0.6rem;
  }

  .course-desc {
    color: #374151;
    font-size: 0.95rem;
  }

  /* Chip&Bot 板块样式 */
  .outreach-section {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid #e5e7eb;
  }

  .outreach-section > h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .chipbot-wrapper {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .chipbot-card {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1.75rem;
  }

  .chipbot-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .chipbot-header h3 {
    font-size: 1.3rem;
    color: #111827;
    margin-bottom: 0.35rem;
  }

  .badge {
    display: inline-block;
    background: #dbeafe;
    color: #1e40af;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .ig-btn {
    color: #be185d;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .chipbot-bio {
    color: #374151;
    font-size: 0.95rem;
    margin-bottom: 1.2rem;
  }

  .chipbot-details {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 0.9rem 1rem;
    font-size: 0.9rem;
    color: #374151;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .chipbot-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .wa-btn {
    background: #16a34a;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 6px;
  }

  .wa-btn:hover {
    background: #15803d;
  }

  .outline-btn {
    border: 1px solid #d1d5db;
    color: #111827;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    background: #ffffff;
  }

  .outline-btn:hover {
    border-color: #111827;
  }

  .ig-embed-box {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }

  @media (max-width: 820px) {
    .chipbot-wrapper {
      grid-template-columns: 1fr;
    }
  }
</style>