---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Research | Laboratory">
  <header class="page-intro">
    <h1 data-i18n="page.research.title">Research</h1>
    <p class="lead" data-i18n="page.research.lead">
      Theoretical modeling, complex network topology, and autonomous systems across astrophysics and communications.
    </p>
  </header>

  <div class="editorial-list">
    {projects.map((project, index) => {
      const num = String(index + 1).padStart(2, '0');
      const prefix = project.id.includes('astro') ? 'astro' : project.id.includes('net') ? 'net' : 'vis';
      return (
        <section class="research-row">
          <div class="row-meta">
            <span class="index-num">{num}</span>
            <h2 data-i18n={`dir.${prefix}.title`}>{project.data.title}</h2>
            <p class="thesis" data-i18n={`dir.${prefix}.sum`}>{project.data.summary}</p>
          </div>

          <div class="row-content">
            {project.data.image && (
              <figure class="figure-box">
                <img src={project.data.image} alt={project.data.title} />
              </figure>
            )}
            <div class="prose">
              <p data-i18n={`prose.${prefix}.p1`}></p>
              <p data-i18n={`prose.${prefix}.p2`}></p>
            </div>
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
  .page-intro {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #111827;
  }

  .page-intro h1 {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .lead {
    font-size: 1.1rem;
    color: #4b5563;
    max-width: 680px;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .research-row {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3.5rem;
    padding: 3.5rem 0;
    border-bottom: 1px solid #e5e7eb;
    align-items: start;
  }

  .research-row:first-child {
    padding-top: 0;
  }

  .research-row:last-child {
    border-bottom: none;
  }

  /* 左侧：编号 + 标题 + 核心命题 */
  .row-meta {
    position: sticky;
    top: 2rem;
  }

  .index-num {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }

  .row-meta h2 {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #111827;
    margin-bottom: 1rem;
  }

  .thesis {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #4b5563;
    border-left: 2px solid #111827;
    padding-left: 0.9rem;
  }

  /* 右侧：无圆角大图 + 学术正文 */
  .row-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .figure-box {
    margin: 0;
    width: 100%;
    background: #f3f4f6;
  }

  .figure-box img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    /* 锐利直角，去掉一切廉价圆角和阴影 */
  }

  .prose {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #1f2937;
  }

  .prose :global(p) {
    margin-bottom: 1.1rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .research-row {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 2.5rem 0;
    }

    .row-meta {
      position: static;
    }

    .figure-box img {
      height: 220px;
    }
  }
</style>