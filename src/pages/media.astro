---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

// 自动扫描 public/images/life 目录下的所有图片
const lifeDir = path.join(process.cwd(), 'public/images/life');
let lifePhotos: string[] = [];

if (fs.existsSync(lifeDir)) {
  lifePhotos = fs
    .readdirSync(lifeDir)
    .filter((file) => /\.(jpe?g|png|webp|avif)$/i.test(file))
    .sort((a, b) => b.localeCompare(a)) // 按文件名倒序，新照片排前面
    .map((file) => `/images/life/${file}`);
}
---
<Layout title="Media & Outreach | Laboratory">
  <header class="page-intro">
    <h1 data-i18n="page.media.title">Media & Outreach</h1>
    <p class="lead" data-i18n="page.media.lead">
      Astronomy science communication, lab soundtracks, and snapshots from our daily work.
    </p>
  </header>

  <div class="editorial-list">
    <section class="media-row">
      <div class="row-meta">
        <span class="index-num">01</span>
        <h2>Köknükte</h2>
        <p class="thesis" data-i18n="media.pk.sub">Astronomy & Astrophysics Outreach</p>
      </div>

      <div class="row-content">
        <p class="prose" data-i18n="media.pk.desc">
          Our independent science communication project dedicated to astrophysics, cosmology, and space exploration. Follow our regular dispatches, visual explainers, and video essays across Instagram and YouTube.
        </p>

        <div class="link-bar">
          <a href="https://www.instagram.com/pale.koknukte/" target="_blank" rel="noopener" class="editorial-link">
            Instagram (@pale.koknukte) ↗
          </a>
          <a href="https://www.youtube.com/@pale.koknukte" target="_blank" rel="noopener" class="editorial-link">
            YouTube Channel ↗
          </a>
        </div>
      </div>
    </section>

    <section class="media-row">
      <div class="row-meta">
        <span class="index-num">02</span>
        <h2 data-i18n="media.pl.title">Lab Work Sessions</h2>
        <p class="thesis" data-i18n="media.pl.sub">Curated Research & Coding Playlist</p>
      </div>

      <div class="row-content">
        <p class="prose" data-i18n="media.pl.desc">
          The audio rotation accompanying our N-body simulations, late-night data reduction, and manuscript drafts.
        </p>

        <div class="video-frame">
          <iframe
            src="https://www.youtube.com/embed/videoseries?list=PLMtk7Af1y8ELs5J2iNb5-tnG5DdgV2Jbv&index=1"
            title="Laboratory Work Playlist"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>

        <div class="link-bar">
          <a href="https://www.youtube.com/playlist?list=PLMtk7Af1y8ELs5J2iNb5-tnG5DdgV2Jbv" target="_blank" rel="noopener" class="editorial-link">
            Open Full Playlist on YouTube ↗
          </a>
        </div>
      </div>
    </section>

    {lifePhotos.length > 0 && (
      <section class="gallery-section">
        <div class="gallery-header">
          <div>
            <span class="index-num">03</span>
            <h2 data-i18n="media.life.title">Life & Moments</h2>
          </div>
          <span class="photo-count">{lifePhotos.length} ARCHIVED FRAMES</span>
        </div>

        <div class="masonry-grid">
          {lifePhotos.map((src) => (
            <figure class="photo-item">
              <img src={src} alt="Laboratory moment" loading="lazy" />
            </figure>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .page-intro {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #111827;
  }

  .page-intro h1 {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .lead {
    font-size: 1.1rem;
    color: #4b5563;
    max-width: 680px;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .media-row {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3.5rem;
    padding: 3.5rem 0;
    border-bottom: 1px solid #e5e7eb;
    align-items: start;
  }

  .media-row:first-child {
    padding-top: 0;
  }

  .index-num {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 0.6rem;
  }

  .row-meta h2,
  .gallery-header h2 {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #111827;
  }

  .row-meta h2 {
    margin-bottom: 0.85rem;
  }

  .thesis {
    font-size: 0.95rem;
    color: #4b5563;
    border-left: 2px solid #111827;
    padding-left: 0.9rem;
  }

  .row-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .prose {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #1f2937;
  }

  .video-frame {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background: #111827;
    border: 1px solid #e5e7eb;
  }

  .video-frame iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .link-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .editorial-link {
    display: inline-block;
    color: #111827;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    padding-bottom: 0.25rem;
    border-bottom: 1.5px solid #111827;
    transition: opacity 0.15s;
  }

  .editorial-link:hover {
    opacity: 0.65;
  }

  /* 03: 瀑布流照片墙 */
  .gallery-section {
    padding-top: 3.5rem;
  }

  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .photo-count {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    color: #6b7280;
    letter-spacing: 0.05em;
  }

  /* 多列瀑布流：完整保留每张照片的原始横竖比例 */
  .masonry-grid {
    columns: 3;
    column-gap: 1.25rem;
  }

  .photo-item {
    break-inside: avoid;
    margin: 0 0 1.25rem 0;
    background: #f3f4f6;
  }

  .photo-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.2s ease;
  }

  .photo-item img:hover {
    opacity: 0.9;
  }

  @media (max-width: 820px) {
    .media-row {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 2.5rem 0;
    }

    .masonry-grid {
      columns: 2;
    }
  }

  @media (max-width: 520px) {
    .masonry-grid {
      columns: 1;
    }
  }
</style>