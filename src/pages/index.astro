---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const researchList = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const allPubs = await getCollection('publications');
const flagshipKeywords = [
  'physical review',
  'astronomy and astrophysics',
  'classical and quantum gravity',
  'scientific reports',
  'ieee transactions'
];

let featuredPubs = allPubs
  .filter((p) => flagshipKeywords.some((kw) => p.data.journal.toLowerCase().includes(kw)))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 5);

if (featuredPubs.length < 5) {
  featuredPubs = allPubs.sort((a, b) => b.data.year - a.data.year).slice(0, 5);
}

const lifeDir = path.join(process.cwd(), 'public/images/life');
let previewPhotos: string[] = [];
if (fs.existsSync(lifeDir)) {
  previewPhotos = fs
    .readdirSync(lifeDir)
    .filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
    .sort((a, b) => b.localeCompare(a))
    .slice(0, 3)
    .map((f) => `/images/life/${f}`);
}
---

<Layout title="Laboratory | Physics, Astrophysics & Complex Networks">
  <header class="hero" id="hero-area">
    <canvas id="topology-canvas"></canvas>

    <div class="hero-content">
      <div class="affiliation" data-i18n="hero.affil">KAZNU • DEPARTMENT OF PHYSICS</div>
      <h1 data-i18n="hero.title">Astrophysics, Complex Networks &amp; Autonomous Systems.</h1>
      <p class="hero-sub" data-i18n="hero.sub">
        Gravitational-wave inference, star cluster topology, entropic networks, and embedded vision.
      </p>
      <div class="hero-actions">
        <a href="/research" class="btn-solid" data-i18n="hero.btn_research">Research →</a>
        <a href="/publications" class="btn-line">
          <span data-i18n="hero.btn_pubs">Publications</span> ({allPubs.length})
        </a>
      </div>
    </div>
  </header>

  <section class="home-section">
    <div class="section-header">
      <h2 data-i18n="sec.directions">Research Directions</h2>
      <a href="/research" class="section-more" data-i18n="sec.overview">Overview ↗</a>
    </div>

    <div class="visual-pillars">
      {researchList.map((item, idx) => {
        const prefix = item.id.includes('astro') ? 'dir.astro' : item.id.includes('net') ? 'dir.net' : 'dir.vis';
        return (
          <a href="/research" class="pillar-card">
            <div class="pillar-img-wrap">
              {item.data.image ? (
                <img src={item.data.image} alt={item.data.title} />
              ) : (
                <div class="img-placeholder">0{idx + 1}</div>
              )}
            </div>
            <div class="pillar-meta">
              <span class="pillar-num">{String(idx + 1).padStart(2, '0')}</span>
              <h3 data-i18n={`${prefix}.title`}>{item.data.title}</h3>
              <p data-i18n={`${prefix}.sum`}>{item.data.summary}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  {featuredPubs.length > 0 && (
    <section class="home-section">
      <div class="section-header">
        <h2 data-i18n="sec.selected_pubs">Selected Publications</h2>
        <a href="/publications" class="section-more">
          <span data-i18n="sec.all">All ↗</span> ({allPubs.length})
        </a>
      </div>

      <div class="pub-feed">
        {featuredPubs.map((pub) => (
          <article class="pub-row">
            <span class="pub-year">{pub.data.year}</span>
            <div class="pub-main">
              <div class="pub-title">
                {pub.data.doi ? (
                  <a href={pub.data.doi} target="_blank" rel="noopener">{pub.data.title}</a>
                ) : (
                  pub.data.title
                )}
              </div>
              <div class="pub-meta">
                <span>{pub.data.authors}</span>
                <span class="sep">•</span>
                <span class="journal">{pub.data.journal}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {previewPhotos.length > 0 && (
    <section class="home-section">
      <div class="section-header">
        <h2 data-i18n="sec.inside_lab">Inside the Lab</h2>
        <a href="/media" class="section-more" data-i18n="sec.gallery">Gallery ↗</a>
      </div>
      <div class="life-strip">
        {previewPhotos.map((src) => (
          <a href="/media" class="life-thumb">
            <img src={src} alt="Lab life" loading="lazy" />
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<script>
  const hero = document.getElementById('hero-area');
  const canvas = document.getElementById('topology-canvas') as HTMLCanvasElement | null;

  if (hero && canvas) {
    const ctx = canvas.getContext('2d');
    let width = 0;
    let height = 0;
    const mouse = { x: -1000, y: -1000 };

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      mass: number;
    }

    let nodes: Node[] = [];

    const resize = () => {
      const rect = hero.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const initNodes = () => {
      nodes = [];
      // 分布重心偏右，避免干扰左侧核心文字阅读，同时铺满整幅首屏
      const centers = [
        { cx: width * 0.68, cy: height * 0.48, count: 32, spread: 140 },
        { cx: width * 0.86, cy: height * 0.28, count: 20, spread: 95 },
        { cx: width * 0.45, cy: height * 0.72, count: 16, spread: 130 },
        { cx: width * 0.22, cy: height * 0.30, count: 12, spread: 120 }
      ];

      centers.forEach((c) => {
        for (let i = 0; i < c.count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const r = Math.pow(Math.random(), 1.35) * c.spread;
          nodes.push({
            x: c.cx + Math.cos(angle) * r,
            y: c.cy + Math.sin(angle) * r,
            vx: (Math.random() - 0.5) * 0.28,
            vy: (Math.random() - 0.5) * 0.28,
            mass: i < 2 ? 3.2 : 1.5
          });
        }
      });
    };

    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 12 || n.x > width - 12) n.vx *= -1;
        if (n.y < 12 || n.y > height - 12) n.vy *= -1;
      }

      const maxDist = 105;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.hypot(dx, dy);
          if (dist < maxDist) {
            const alpha = (1 - dist / maxDist) * 0.22;
            ctx.strokeStyle = `rgba(17, 24, 39, ${alpha})`;
            ctx.lineWidth = 0.9;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }

        const mdx = nodes[i].x - mouse.x;
        const mdy = nodes[i].y - mouse.y;
        const mDist = Math.hypot(mdx, mdy);
        if (mDist < 135) {
          ctx.strokeStyle = `rgba(29, 78, 216, ${(1 - mDist / 135) * 0.5})`;
          ctx.lineWidth = 1.1;
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.stroke();
        }
      }

      for (const n of nodes) {
        ctx.fillStyle = n.mass > 2.5 ? 'rgba(29, 78, 216, 0.75)' : 'rgba(17, 24, 39, 0.55)';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.mass, 0, Math.PI * 2);
        ctx.fill();
      }

      requestAnimationFrame(draw);
    };

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    hero.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    window.addEventListener('resize', () => {
      resize();
      initNodes();
    });

    resize();
    initNodes();
    draw();
  }
</script>

<style>
  /* 首屏：全宽动态画布背景 + 前景极简文字 */
  .hero {
    position: relative;
    padding: 4.5rem 0 5rem;
    border-bottom: 2px solid #111827;
    overflow: hidden;
  }

  #topology-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 660px;
    pointer-events: none;
  }

  .affiliation {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #6b7280;
    margin-bottom: 1rem;
  }

  .hero-content h1 {
    font-size: 2.85rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #111827;
    margin-bottom: 1.1rem;
  }

  .hero-sub {
    font-size: 1.08rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    pointer-events: auto;
  }

  .btn-solid {
    background: #111827;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.65rem 1.3rem;
    transition: background-color 0.15s;
  }

  .btn-solid:hover {
    background: #1d4ed8;
  }

  .btn-line {
    color: #111827;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding-bottom: 0.2rem;
    border-bottom: 1.5px solid #111827;
    transition: opacity 0.15s;
  }

  .btn-line:hover {
    opacity: 0.65;
  }

  /* 通用区块 */
  .home-section {
    padding: 3.25rem 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .home-section:last-child {
    border-bottom: none;
    padding-bottom: 1rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section-more {
    font-size: 0.88rem;
    font-weight: 600;
    color: #4b5563;
    text-decoration: none;
  }

  .section-more:hover {
    color: #111827;
  }

  /* 第二屏：三大研究支柱 */
  .visual-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .pillar-img-wrap {
    width: 100%;
    height: 190px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    margin-bottom: 1.1rem;
    overflow: hidden;
  }

  .pillar-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .pillar-card:hover .pillar-img-wrap img {
    transform: scale(1.03);
  }

  .img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: monospace;
    font-size: 1.5rem;
    color: #9ca3af;
  }

  .pillar-num {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 0.35rem;
  }

  .pillar-meta h3 {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .pillar-card:hover .pillar-meta h3 {
    color: #1d4ed8;
  }

  .pillar-meta p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #4b5563;
  }

  /* 第三屏：代表性论文列表 */
  .pub-feed {
    display: flex;
    flex-direction: column;
  }

  .pub-row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid #f3f4f6;
    align-items: baseline;
  }

  .pub-row:last-child {
    border-bottom: none;
  }

  .pub-year {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    color: #6b7280;
    font-weight: 600;
  }

  .pub-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: #111827;
    margin-bottom: 0.25rem;
  }

  .pub-title a {
    color: #111827;
    text-decoration: none;
  }

  .pub-title a:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  .pub-meta {
    font-size: 0.88rem;
    color: #4b5563;
  }

  .sep {
    margin: 0 0.4rem;
    color: #9ca3af;
  }

  .journal {
    font-style: italic;
    color: #111827;
    font-weight: 500;
  }

  /* 第四屏：生活照横幅 */
  .life-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .life-thumb {
    display: block;
    height: 200px;
    background: #f3f4f6;
    overflow: hidden;
  }

  .life-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .life-thumb:hover img {
    opacity: 0.88;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 3rem 0 3.5rem;
    }

    .hero-content h1 {
      font-size: 2.1rem;
    }

    .visual-pillars,
    .life-strip {
      grid-template-columns: 1fr;
    }

    .pub-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>