---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const items = (await getCollection('instrumentation')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Hardware & Facilities | Laboratory">
  <header class="page-intro">
    <h1 data-i18n="page.hw.title">Hardware & Facilities</h1>
    <p class="lead" data-i18n="page.hw.sub">
      High-performance GPU workstations, embedded testbeds, and unmanned aerial platforms.
    </p>
  </header>

  <div class="editorial-list">
    {items.map(async (item, index) => {
      const { Content } = await render(item);
      const num = String(index + 1).padStart(2, '0');
      return (
        <section class="hw-row">
          <div class="row-meta">
            <span class="index-num">{num}</span>
            <h2>{item.data.title}</h2>
            <p class="specs">{item.data.specs}</p>
          </div>

          <div class="row-content">
            <div class="prose">
              <Content />
            </div>
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
  .page-intro {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #111827;
  }

  .page-intro h1 {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .lead {
    font-size: 1.1rem;
    color: #4b5563;
    max-width: 680px;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .hw-row {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3.5rem;
    padding: 3rem 0;
    border-bottom: 1px solid #e5e7eb;
    align-items: start;
  }

  .hw-row:first-child {
    padding-top: 0;
  }

  .hw-row:last-child {
    border-bottom: none;
  }

  .index-num {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 0.6rem;
  }

  .row-meta h2 {
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #111827;
    margin-bottom: 0.85rem;
  }

  .specs {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.84rem;
    line-height: 1.5;
    color: #374151;
    border-left: 2px solid #111827;
    padding-left: 0.85rem;
  }

  .prose {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #1f2937;
  }

  .prose :global(p) {
    margin-bottom: 1.1rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .hw-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2.25rem 0;
    }
  }
</style>